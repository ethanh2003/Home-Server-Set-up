# OS / System
.DS_Store
Thumbs.db

# Global Ignore Patterns for Configuration & Data
# Matches any directory ending in _config, _data, _db at root or sub-levels
*_config/
*_data/
*_db/

# Monitoring configuration is declarative IaC, not runtime application state.
!monitoring-stack/prometheus_config/
!monitoring-stack/prometheus_config/prometheus.yml
!monitoring-stack/prometheus_config/rules/
!monitoring-stack/prometheus_config/rules/*.yml
!monitoring-stack/blackbox_config/
!monitoring-stack/blackbox_config/*.yml

# Matches standard config/data directory names inside service folders
*/config/
*/data/
*/database/
*/db/
*/appdata/
*/metadata/

# Specific Directories (Legacy or irregular names)
portainer_data/
grafana_provisioning/
.db_dumps/
downloads/
*/downloads/
temp/
*/temp/

# Environment Variables & Secrets
.env
*.env
!*.env.example
!*.sops.env
secrets.yaml
!secrets.example.yaml
*.key
*.pem
*.crt
*_key
*_key.pub
id_rsa*
id_ed25519*
id_ecdsa*

# specific backups and large files
rclone_backup.log
sftp/host_keys/
sftp/sftpgo_backup/
home-assistant/backups/
cloudflared/backups/

# Database Files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Logs & Temporary Files
*.log
logs/
*/logs/
arr-suite/reports/
*.pid
*.bak
*.lock
__pycache__/
*.pyc
.cache/
*/.cache/
.gemini/
gha-creds-*.json
github-runner/runner_work/
wiki/postgres-data/
monitoring-stack/node_exporter_textfile/*.prom

# Generated runtime state, local build checkouts, and recovery artifacts
*-data/
*/state/
*/reports/
*/node_modules/
*/.venv/
*/.pytest_cache/
*/backups/
*.codex-bak-*
*.save
*corrupt-*/
*crash-*/
actual-budget/actual-auto-sync-src/
spotify-stats/upstream-your_spotify/
