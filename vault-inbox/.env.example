VAULT_INBOX_DATABASE_PATH=/data/vault-inbox.sqlite3
VAULT_INBOX_VAULT_ROOT=/vault
VAULT_INBOX_APP_REPO_ROOT=/app
VAULT_INBOX_PUBLIC_BASE_URL=https://inbox.ethan-herring.com
VAULT_INBOX_OLLAMA_BASE_URL=http://192.168.1.185:11434
VAULT_INBOX_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Keep false until the Codex auth path is deliberately verified.
VAULT_INBOX_CODEX_ENABLED=false
VAULT_INBOX_CODEX_BINARY=codex
VAULT_INBOX_CODEX_TIMEOUT_SECONDS=900
VAULT_INBOX_WORKER_ENABLED=false
VAULT_INBOX_WORKER_STALE_RUNNING_SECONDS=1800

# Production defaults hide API docs and internal host/path details.
VAULT_INBOX_DOCS_ENABLED=false
VAULT_INBOX_HEALTH_DETAILS_ENABLED=false
VAULT_INBOX_CORS_ALLOWED_ORIGINS=https://inbox.ethan-herring.com,http://localhost:5173,http://127.0.0.1:5173
VAULT_INBOX_URL_INGEST_ALLOW_PRIVATE_NETWORKS=false

VAULT_INBOX_SMTP_ENABLED=true
VAULT_INBOX_SMTP_HOST=smtp-relay
VAULT_INBOX_SMTP_PORT=25
VAULT_INBOX_SMTP_FROM=vault-inbox@ethan-herring.com
VAULT_INBOX_SMTP_TO=admin@ethan-herring.com
