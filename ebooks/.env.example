PUID=1000
PGID=1000
TZ=America/New_York

# Existing Calibre library. Preserve this path unless intentionally migrating.
CALIBRE_LIBRARY_PATH=/mnt/data_14tb/media/books

# Completed EPUBs can be moved here for CWA import. Do not download directly here.
CWA_INGEST_PATH=/data/staging/ebooks/cwa-ingest

# LazyLibrarian/qBittorrent staging. Do not point this at the Calibre library root.
# qBittorrent sees this under /data/downloads/ebooks via arr-suite's media mount.
LAZYLIBRARIAN_DOWNLOADS_PATH=/mnt/data_14tb/media/downloads/ebooks

# LAN/VPN-only host ports. No public reverse-proxy route is configured by this stack.
CWA_PORT=8083
LAZYLIBRARIAN_PORT=5299

# Optional for scripts/storygraph_wishlist_import.py --import-lazylibrarian.
# Keep the real API key only in untracked .env or shell environment.
LAZYLIBRARIAN_URL=http://127.0.0.1:5299
LAZYLIBRARIAN_API_KEY=

# Poll the StoryGraph CSV drop folder and generate wishlist/report files.
# API import/search is disabled until LazyLibrarian API is enabled and the key is set.
STORYGRAPH_WATCH_INTERVAL=60
STORYGRAPH_IMPORT_LAZYLIBRARIAN=false
STORYGRAPH_SEARCH_AFTER_IMPORT=false
